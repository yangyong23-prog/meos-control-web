        "husky": "^8.0.3",
        "lint-staged": "^13.2.3",
        "mini-css-extract-plugin": "^2.7.6",
        "postcss": "^8.4.25",
        "postcss-html": "^1.5.0",
        "postcss-loader": "^7.3.3",
        "postcss-scss": "^4.0.6",
        "prettier": "^2.8.8",
        "purgecss-webpack-plugin": "^5.0.0",
        "rimraf": "^5.0.5",
        "sass": "^1.63.6",
        "sass-loader": "^13.3.2",
        "sass-resources-loader": "^2.2.5",

{
    "name": "rcrm",
    "version": "0.0.1",
    "description": "关系图资源管理平台",
    "author": "",
    "main": "index.js",
    "scripts": {
        "dev": "webpack-dev-server --mode development -c config/dev.js",
        "build": "rimraf rcrm && webpack --mode production -c config/build.js ",
        "lint-staged": "npx lint-staged",
        "lint": "eslint src --fix --ext .ts,.tsx,.vue,.js,.jsx",
        "stylelint": "stylelint src/**/*.{less,scss,css,vue} --fix "
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.vue": [
            "stylelint --fix",
            "prettier --write",
            "eslint --fix"
        ],
        "*.{less,scss,css,sass}": [
            "stylelint --fix",
            "prettier --write"
        ]
    },
    "keywords": [],
    "license": "ISC",
    "dependencies": {
        "@vueuse/core": "^9.13.0",
        "@yushu/relation-chart": "1.1.16",
        "axios": "^0.27.2",

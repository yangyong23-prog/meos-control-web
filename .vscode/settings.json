{
	"editor.formatOnSave": false, // 关闭掉formatOnSave 使用eslint 来修复
	"prettier.bracketSameLine": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
		"source.fixAll.stylelint": "explicit"
	},
	"eslint.enable": true,
	"eslint.run": "onType",
	"eslint.workingDirectories": [
		{
			"directory": ".",
			"changeProcessCWD": true
		},
		{
			"directory": "meoi-aim-rcrm-web",
			"changeProcessCWD": true
		}
	],
	"stylelint.enable": true,
	"css.validate": false,
	"less.validate": false,
	"scss.validate": false,
	"stylelint.validate": [
		"vue",
		"html",
		"css",
		"less",
		"scss",
		"sass",
		"stylus",
		"postcss"
	],
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"vue",
		"typescript",
		"typescriptreact"
	],
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[scss]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[vue]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[less]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"liveServer.settings.port": 5501,
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": true,
		"scminput": false,
		"javascript": true,
		"vue": true
	},
	"github.copilot.chat.localeOverride": "zh-CN",
	"i18n-ally.localesPaths": [
		"locales",
		"locales/langs",
	],
	"i18n-ally.sortKeys": false,
	"i18n-ally.indent": 4,
	"i18n-ally.namespace": true,
	"i18n-ally.enabledParsers": [
		"json"
	], // 翻译文件可允许的格式，默认json
	"i18n-ally.sourceLanguage": "zh", // 翻译源语言 (源文件) 根据此语言文件翻译其他语言文件的变量和内容
	"i18n-ally.displayLanguage": "zh", // 显示语言 (显示文件/翻译文件)
	"i18n-ally.translate.engines": [
		"deepl",
		"google"
	], // 翻译器
	"i18n-ally.extract.keygenStyle": "snake_case", // 键生成样式
	"i18n-ally.enabledFrameworks": [
		"vue"
	],
	"i18n-ally.keystyle": "nested",
	"chat.agentSkillsLocations": {
		".github/skills/meri-ui": true,
		".github/skills/meri-ui/meri-ui-color-guidelines": true,
		".agents/skills/meos-control-web-skills": true,
		".agents/skills": true,
	},
	"chat.instructionsFilesLocations": {
		".agents/instructions": true
	}
}
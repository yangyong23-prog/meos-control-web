{
    "name": "meos-control-web",
    "author": "chenpeng",
    "private": true,
    "version": "1.0.0",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=8.0.0"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev:check": "bash localscripts/run-with-node20.sh pnpm run dev",
        "dev": "vite --host",
        "dev:micro": "vite --mode micro",
        "impact:report": "node scripts/generate-impact-report.cjs",
        "build": "vite build",
        "build:edge": "vite build -- --client edge",
        "build:gray": "vite build -- --client gray",
        "report": "vue-tsc && vite build  --mode report",
        "prepare": "husky install",
        "lint:fix": "eslint --fix --ext .js,.ts,.jsx,.tsx,.vue src --quiet",
        "lint-staged": "lint-staged && vue-tsc --noEmit && tsc --noEmit",
        "stylelint": "stylelint  src/**/*.{vue,scss,css,sass,less} --fix",
        "copy": "pnpm run build && cp -r meos-control-web ~/Documents/static"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "!(meos-daily-report-web)/**/*.{js,ts,jsx,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "!(meos-daily-report-web)/**/*.vue": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "dependencies": {
        "@antv/g6": "5.0.43",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@tweenjs/tween.js": "^18.6.4",
        "@vueuse/core": "^10.11.0",
        "@yushu/3d-graph-engine": "1.0.4-beta4",
        "@yushu/core3d": "2.0.10",
        "@yushu/effecttool": "2.7.31",
        "@yushu/relation-chart": "1.1.17",
        "@yushu/three-base": "^1.0.7",
        "@yushu/tree-graph": "0.0.5",
        "@yushu/tree-node": "0.0.51",
        "aim-vue-icon": "^1.5.8",
        "animejs": "^4.1.1",
        "array.prototype.at": "^1.1.2",
        "axios": "1.2.0",
        "camera-controls": "^2.7.1",
        "change-case": "4.1.2",
        "cheerio": "^1.0.0-rc.10",
        "dayjs": "^1.11.9",
        "decimal.js": "^10.4.3",
        "dexie": "^3.2.4",
        "dompurify": "^3.2.5",
        "echarts": "^5.5.1",
        "element-plus": "^2.7.0",
        "event-source-polyfill": "^1.0.31",
        "js-cookie": "3.0.1",
        "konva": "^9.3.18",
        "lodash": "4.17.21",
        "meri-icon": "^1.5.2",
        "meri-plus": "4.1.24-beta",
        "mitt": "^3.0.1",
        "monitor-video": "2.0.6",
        "nanoid": "^5.0.6",
        "p-limit": "^7.3.0",
        "persagy-tools": "1.0.73",
        "pinia": "2.0.26",
        "pinia-plugin-persistedstate": "3.0.1",
        "qiankun": "^2.10.16",
        "qs": "6.11.0",
        "swiper": "^11.2.10",
        "three-bvh-csg": "0.0.16",
        "three-mesh-bvh": "^0.6.6",
        "vue": "3.5.13",
        "vue-draggable-plus": "^0.6.0",
        "vue-i18n": "^11.1.1",
        "vue-router": "^4.5.0",
        "vuedraggable": "^4.1.0",
        "yushu-component-web": "0.2.3",
        "yushu-js-utils": "1.3.16"
    },
    "pnpm": {
        "overrides": {
            "local-pkg": "1.1.1"
        }
    },
    "devDependencies": {
        "@commitlint/cli": "17.3.0",
        "@commitlint/config-conventional": "17.3.0",
        "@types/js-cookie": "3.0.2",
        "@types/lodash": "4.14.190",
        "@types/node": "18.11.9",
        "@types/qs": "6.9.7",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "@vitejs/plugin-legacy": "^2.3.1",
        "@vitejs/plugin-vue": "^3.2.0",
        "@vitejs/plugin-vue-jsx": "^2.1.1",
        "chalk": "5.1.2",
        "consola": "2.15.3",
        "eslint": "^8.46.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-import": "^2.28.0",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-vue": "^9.16.1",
        "husky": "8.0.2",
        "less": "4.1.3",
        "lint-staged": "13.0.3",
        "lodash": "^4.17.21",
        "meri-skills": "^0.0.4",
        "mockjs": "^1.1.0",
        "postcss": "^8.4.29",
        "postcss-html": "^1.7.0",
        "prettier": "^2.8.8",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-visualizer": "5.8.3",
        "sass": "^1.64.2",
        "spark-md5": "^3.0.2",
        "stylelint": "^14.16.1",
        "stylelint-config-recommended-vue": "^1.5.0",
        "stylelint-config-standard": "^26.0.0",
        "stylelint-config-standard-scss": "^5.0.0",
        "stylelint-order": "^5.0.0",
        "stylelint-scss": "^4.7.0",
        "terser": "^5.19.2",
        "typescript": "^4.9.5",
        "unplugin-auto-import": "0.18.6",
        "unplugin-vue-components": "^0.21.2",
        "unplugin-vue-define-options": "^0.7.3",
        "vite": "4.5.0",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-html": "^3.2.2",
        "vite-plugin-html-template": "^1.2.0",
        "vite-plugin-mock": "2.9.8",
        "vite-plugin-qiankun-persagy": "^0.0.3",
        "vite-plugin-svg-icons": "^2.0.1",
        "vite-plugin-vue-devtools": "^7.3.1",
        "vite-plugin-vue-setup-extend": "^0.4.0",
        "vite-svg-loader": "^3.6.0",
        "vue-tsc": "1.2.0"
    }
}
